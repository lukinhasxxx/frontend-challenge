# Ativa a camada de mocks (MSW + Socket.IO simulado). Usado em dev, demo e testes.
VITE_ENABLE_MOCKS=true

# Servidor Socket.IO. Com mocks ativos, é um host sentinela interceptado pelo MSW
# (não resolve na rede: se o mock falhar, o erro aparece em vez de bater no Vite).
VITE_SOCKET_URL=ws://realtime.mock
